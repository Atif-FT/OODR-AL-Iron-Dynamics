&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  prefix = 'fe_bulk_16atom'
  pseudo_dir = './pseudo'
  outdir = './tmp'
  tstress = .true.
  tprnfor = .true.
  disk_io = 'none'
/
&SYSTEM
  ibrav = 0
  nat = 16
  ntyp = 1
  ecutwfc = 50.0
  ecutrho = 400.0
  occupations = 'smearing'
  smearing = 'cold'
  degauss = 0.02
  nspin = 2
  starting_magnetization(1) = 0.5
/
&ELECTRONS
  diagonalization = 'david'
  mixing_beta = 0.4
  mixing_mode = 'local-TF'
  conv_thr = 1.0d-6
  electron_maxstep = 100
/
ATOMIC_SPECIES
  Fe  55.845  Fe.pbe-spn-kjpaw_psl.0.2.1.UPF
K_POINTS automatic
  4 4 4 0 0 0
