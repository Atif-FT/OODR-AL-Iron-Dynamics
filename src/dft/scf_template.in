&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  prefix = 'fe_system'
  pseudo_dir = './pseudo'
  outdir = './tmp'
  tstress = .true.
  tprnfor = .true.
  disk_io = 'none'
/
&SYSTEM
  ibrav = 0
  celldm(1) = 1.0
  nat = 2
  ntyp = 1
  ecutwfc = 50.0
  ecutrho = 400.0
  occupations = 'smearing'
  smearing = 'cold'
  degauss = 0.02
  nspin = 2
  starting_magnetization(1) = 0.5
/
&ELECTRONS
  diagonalization = 'david'
  mixing_beta = 0.7
  conv_thr = 1.0d-6
/
ATOMIC_SPECIES
  Fe  55.845     Fe.pbe-spn-kjpaw_psl.0.2.1.UPF
ATOMIC_POSITIONS crystal
  Fe 0.0 0.0 0.0
  Fe 0.5 0.5 0.5
K_POINTS automatic
  4 4 4 0 0 0
