# tribo_sliding.in
# LAMMPS input script for tribological sliding simulation at Al-Fe interface using MACE

units           metal
boundary        p p f      # Periodic in X, Y; fixed/open boundary in Z
atom_style      atomic

# 1. Load atomic structure
# The structure should have a top block of Fe (type 1) and a bottom block of Fe (type 2)
# separated by a small gap or in contact.
read_data       data.fe_tribo

# 2. Setup MACE potential
# Maps elements to MACE elements. If LAMMPS uses type 1 and type 2 for top/bottom Fe blocks,
# both are mapped to Fe.
pair_style      mace
pair_coeff      * * Fe_Stage3_swa.model Fe Fe

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

# 3. Define groups based on Z coordinates
# Typically we have:
# - fixed bottom: bottom layers of Fe block
# - fixed top: top layers of Al block
# - thermostat bottom/top: zones next to fixed layers to dissipate heat
# - active zone: the sliding interface
# (Indices assume they are pre-defined in data.tribo or we define them by Z region)
# Let's assume regions are defined as:
region          bot_fixed block INF INF INF INF INF 5.0
region          bot_thermo block INF INF INF INF 5.0 15.0
region          top_thermo block INF INF INF INF 45.0 55.0
region          top_fixed block INF INF INF INF 55.0 INF

group           g_bot_fixed region bot_fixed
group           g_bot_thermo region bot_thermo
group           g_top_thermo region top_thermo
group           g_top_fixed region top_fixed
group           g_boundary union g_bot_fixed g_top_fixed
group           g_active subtract all g_boundary

# 4. Energy minimization with boundary atoms frozen
fix             f_freeze g_boundary setforce 0.0 0.0 0.0
minimize        1.0e-6 1.0e-8 1000 10000
unfix           f_freeze

# 5. Velocity initialization and equilibration (NVT at 300 K)
reset_timestep  0
velocity        g_active create 300.0 98765 dist gaussian
velocity        g_boundary setforce 0.0 0.0 0.0

# Apply thermostat to active and buffer zones, keep boundaries frozen
fix             f_freeze g_boundary setforce 0.0 0.0 0.0
fix             f_thermo g_active nvt temp 300.0 300.0 0.1
run             5000
unfix           f_thermo

# 6. Apply Normal Load and Sliding
# (a) Normal load: press top fixed block down with a force along Z
# (b) Sliding: move top fixed block at constant velocity along X
variable        v_sliding equal 0.1  # 0.1 A/ps = 10 m/s
variable        f_normal equal -0.5   # normal force per atom (eV/A)

velocity        g_top_fixed set 0.0 0.0 0.0
velocity        g_bot_fixed set 0.0 0.0 0.0

# Apply sliding velocity along X, normal load along Z to top block
fix             f_load g_top_fixed addforce 0.0 0.0 ${f_normal}
fix             f_slide g_top_fixed setforce 0.1 NULL 0.0   # Constant velocity 10 m/s along X

# Apply NVT thermostat to dissipation zones (dissipate friction heat)
group           g_thermostatted union g_bot_thermo g_top_thermo
fix             f_nvt_active g_thermostatted nvt temp 300.0 300.0 0.1
# Run integration on active sliding zone in NVE (allows temperature to evolve at interface)
group           g_interface subtract g_active g_thermostatted
fix             f_nve_interface g_interface nve

# Setup output variables to compute friction coefficient
variable        fx_fric equal f_slide[1]
variable        fz_norm equal f_load[3]

thermo          100
thermo_style    custom step temp pe ke v_fx_fric v_fz_norm
dump            1 all custom 200 traj_tribo.lammpstrj id type x y z fx fy fz

# Run sliding for 100,000 steps (100 ps)
run             100000

print "=== Tribological Sliding Simulation Complete ==="
