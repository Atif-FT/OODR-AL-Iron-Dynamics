# thermal_shock.in
# LAMMPS input script for 1800 K thermal shock simulation of pure BCC Iron (Fe) using MACE

units           metal
boundary        p p p
atom_style      atomic

# 1. Load atomic structure
read_data       data.fe

# 2. Setup MACE interatomic potential
pair_style      mace
pair_coeff      * * models/MACE_OODR_AL_Comprehensive.model Fe

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

# 3. Energy minimization
thermo          50
minimize        1.0e-6 1.0e-8 1000 10000

# 4. Thermal Equilibration (NVT at 300 K)
reset_timestep  0
velocity        all create 300.0 54321 dist gaussian
fix             1 all nvt temp 300.0 300.0 0.1
run             5000
unfix           1

# 5. Thermal Shock (Instantaneous velocity rescaling to 1800 K)
reset_timestep  0
velocity        all create 1800.0 12345 dist gaussian

# 6. Microcanonical (NVE) Relaxation Phase
# For publication Figure 7 & Figure 8 analysis, 5,000 steps (5.0 ps) are sampled.
# For long-duration stability benchmarking (>50,000 steps as reported in Table 1), set nsteps to 50000.
variable        nsteps equal 50000
fix             2 all nve
thermo          100
thermo_style    custom step temp pe ke etotal press
dump            1 all custom 100 traj_shock.lammpstrj id type x y z fx fy fz
run             ${nsteps}

print "=== 1800 K Thermal Shock NVE Simulation Complete ==="
