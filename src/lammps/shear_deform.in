# shear_deform.in
# LAMMPS input script for high strain-rate shear deformation of pure BCC Iron (Fe) at 1800 K using MACE

units           metal
boundary        p p p
atom_style      atomic

# 1. Load atomic structure
read_data       data.fe

# 2. Setup MACE interatomic potential
pair_style      mace
pair_coeff      * * models/MACE_OODR_AL_Comprehensive.model Fe

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

# 3. Energy minimization
echo            screen
thermo          50
thermo_style    custom step temp pe ke etotal press lx ly lz
minimize        1.0e-6 1.0e-8 1000 10000

# 4. Thermal Equilibration (NVT at 1800 K)
reset_timestep  0
velocity        all create 1800.0 12345 dist gaussian
fix             1 all nvt temp 1800.0 1800.0 0.1
run             5000
unfix           1

# 5. Non-Equilibrium Shear Deformation (High Strain-Rate: 10^9 s^-1 = 0.001 ps^-1)
# Timestep in metal units is 0.001 ps (1.0 fs).
# 10,000 steps = 10.0 ps, corresponding to total shear strain gamma = 0.01 * 10 = 0.10 (10%).
variable        srate equal 0.001
fix             1 all nvt temp 1800.0 1800.0 0.1
fix             2 all deform 1 xy erate ${srate} units box remap v

# Setup thermo output and trajectory dump
thermo          100
thermo_style    custom step temp pe ke etotal press pxy lx ly lz
dump            1 all custom 100 traj_shear.lammpstrj id type x y z fx fy fz
dump_modify     1 sort id

# Run shear deformation for 10,000 steps
run             10000

print "=== 1800 K Shear Deformation Simulation Complete ==="
